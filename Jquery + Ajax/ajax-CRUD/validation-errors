error: function (xhr) {

    if (xhr.status === 422) {

        let response = xhr.responseJSON;

        let errors = response.errors;

        let messages = '';

        $.each(errors, function (field, message) {

            messages += message + "\n";

        });

        alert(messages);

    } else {

        alert('Something went wrong.');

    }

}

