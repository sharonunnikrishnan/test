public function show($id)
{
    $model = new EmployeeModel();

    $employee = $model->find($id);

    if (!$employee) {
        return $this->response
            ->setStatusCode(404)
            ->setJSON([
                'status'  => false,
                'message' => 'Employee not found'
            ]);
    }

    return $this->response->setJSON([
        'status' => true,
        'data'   => $employee
    ]);
}

