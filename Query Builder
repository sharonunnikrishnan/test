    public function search()
{
    $search = $this->request->getGet('search');

    $db = \Config\Database::connect();

    $builder = $db->table('employees');

    if ($search) {
        $builder->groupStart()
            ->like('name', $search)
            ->orLike('email', $search)
            ->orLike('phone', $search)
            ->orLike('department', $search)
            ->groupEnd();
    }

    $employees = $builder
        ->orderBy('id', 'DESC')
        ->get()
        ->getResultArray();

    return view('employees/index', [
        'employees' => $employees
    ]);
}


